# Claude Code project-level state — machine-specific
.claude/settings.json
.claude/settings.local.json
.claude/lumen/

# Keep: .claude/hooks/ (the hook scripts)
# Keep: .mcp.json (now contains no machine-specific paths)
# Keep: CLAUDE.md and DESIGN_CONTRACT.md

# macOS noise
.DS_Store
.AppleDouble
.LSOverride
__MACOSX/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# MCP / local tooling configs
.playwright-mcp/

# Personal screenshots (not referenced by docs)
lumen_usage.png

# Tauri scaffold boilerplate (not the project README)
lumenator/README.md

# Environment / secrets
.env
.env.*
*.pem
*.key

# Pre-compiled sidecars (rebuilt via build-sidecar.sh)
lumenator/src-tauri/binaries/
