{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/hooks/lumen_read_intercept.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/hooks/lumen_meter.sh"
          }
        ]
      },
      {
        "matcher": "mcp__lumen__smart_read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/hooks/lumen_meter.sh"
          }
        ]
      },
      {
        "matcher": "mcp__lumen__recall_file",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/hooks/lumen_meter.sh"
          }
        ]
      },
      {
        "matcher": "mcp__lumen__compress_logs",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/hooks/lumen_meter.sh"
          }
        ]
      }
    ]
  }
}
